# Copiez ce fichier sous .env et adaptez les valeurs.
HOST_GRPC_BIND_IP=127.0.0.1
HOST_WEB_BIND_IP=127.0.0.1
PHARMACIE_HOST_PORT=50052
RADIOLOGIE_HOST_PORT=50053
GATEWAY_HOST_PORT=8000
UI_HOST_PORT=8501

# Créer une clé aléatoire pour protéger les routes /api/v1/* sur un VPS.
# Exemple : python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Facultatif : clé séparée réservée aux mises à jour de stock.
STOCK_WRITE_API_KEY=
CORS_ALLOW_ORIGINS=
GRPC_TIMEOUT_SECONDS=2
HEALTH_CHECK_TIMEOUT_SECONDS=2
PHARMACIE_LATENCE_MS=0
RADIOLOGIE_LATENCE_MS=0

# Pour compose.tls.yaml uniquement : chemins vers fichiers de certificat locaux.
# Les fichiers ne doivent pas être ajoutés à Git. Le certificat serveur doit
# inclure les noms DNS pharmacie et radiologie dans son SAN.
TLS_SERVER_CERT_PATH=./certs/server.crt
TLS_SERVER_KEY_PATH=./certs/server.key
TLS_SERVER_CA_PATH=./certs/ca.crt
TLS_CLIENT_CA_PATH=./certs/ca.crt
TLS_GATEWAY_CERT_PATH=./certs/gateway-client.crt
TLS_GATEWAY_KEY_PATH=./certs/gateway-client.key
TLS_UI_CERT_PATH=./certs/ui-client.crt
TLS_UI_KEY_PATH=./certs/ui-client.key
TLS_PROBE_CERT_PATH=./certs/probe-client.crt
TLS_PROBE_KEY_PATH=./certs/probe-client.key
